; Engine configuration file — OVERCLOCK
; Minimal bootstrap project that initializes the Redot/Godot 4.6 project so the
; GdUnit4 test harness can run headlessly (local + CI). Rendering/input/autoload
; settings are added during Pre-Production as the vertical slice is built.
;
; Engine: Redot 26.2 (Godot 4.6-compatible). See docs/engine-reference/godot/VERSION.md.

config_version=5

[application]

; Stamped in the main menu's footer — the spec keeps it there specifically so a
; playtest bug report can name the build it came from.
config/version="0.1.0-vslice"

config/name="OVERCLOCK"
run/main_scene="res://scenes/main_menu.tscn"
; ★ 2026-08-24: boot destination is the MAIN MENU, per design/ux/main-menu.md
; ("always the boot destination and the return target from pause -> Quit to Main
; Menu"). The slice is now reached through New Skirmish rather than being the
; application root. Tools that want the board directly load
; res://scenes/vertical_slice.tscn themselves (tools/CaptureSlice.tscn does).
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; Vertical-slice window. The board (~1408x704 world px) is framed to fit via
; VerticalSliceRoot's fit-to-view camera; resizing refits. Resizable (default).
window/size/viewport_width=1600
window/size/viewport_height=900

[autoload]

; Thin, logic-free lookup Autoload (ADR-0006), mirroring MatchService's
; read-only lookup idiom (ADR-0001). Loads EconomyConfig once at boot;
; AP's static functions read Balance.economy internally.
Balance="*res://src/core/economy/balance.gd"

; ★ 2026-08-24. The player's own preferences, loaded and applied ONCE at boot so
; saved key bindings are live in the InputMap before the first frame that could
; read them. Loading these lazily inside the settings screen would mean the game
; ran on default bindings until the player happened to open settings.
Settings="*res://src/core/settings/settings_service.gd"

; ★ 2026-08-25 (S8-06). Names a bound action the way the device the player is CURRENTLY
; using names it — "[B]" on a keyboard, "[LB]" on a pad. Every binding has had a gamepad
; event since S6-17/S6-20, but nothing DISPLAYED them, so a controller player was told to
; press keys they do not have. A Steam Deck Verified criterion, not a nicety.
; Needs to be a Node (it watches _input for the active device), hence an Autoload rather
; than a static helper. No dependencies, so order does not matter.
InputGlyphs="*res://src/ui/input/input_glyphs.gd"

; Thin, logic-free registry Autoload (ADR-0007), mirroring Balance's idiom.
; Preloads the 4 VS UnitTypeDef presets once at boot; any system reads
; UnitTypes.SCOUT/TROOPER/HEAVY/SNIPER as a bare global reference.
UnitTypes="*res://src/core/unit/unit_types.gd"

; Thin, logic-free config Autoload (ADR-0009), a sibling of Balance. Loads the
; UnitConfig movement-tuning resource once at boot; UnitConfig.surcharge_for()
; reads UnitBalance.units.soft_move_penalty_x10 internally.
UnitBalance="*res://src/core/unit/unit_balance.gd"

; Thin, logic-free config Autoload (ADR-0010), a sibling of Balance/UnitBalance.
; Loads the CombatConfig damage-formula tuning resource once at boot; Combat's
; damage()/preview_damage() read CombatBalance.combat.* internally.
CombatBalance="*res://src/core/combat/combat_balance.gd"

; Thin, logic-free registry Autoload (ADR-0007), mirroring UnitTypes' idiom.
; Preloads the 5 VS StructureTypeDef presets (HQ, Economy/Production Outpost,
; Defensive Structure, Research Lab) once at boot; any system reads
; StructureTypes.HQ/ECONOMY_OUTPOST/... as a bare global reference.
StructureTypes="*res://src/core/structure/structure_types.gd"

; Thin, logic-free config Autoload (ADR-0017 D6), a sibling of Balance/
; UnitBalance/CombatBalance. Loads the BaseProductionConfig tuning resource
; once at boot; Base & Production (and cross-system readers like Combat's
; defensive_attack_cost) read StructureBalance.base_production.* internally.
StructureBalance="*res://src/core/base_production/structure_balance.gd"

; Thin config Autoload (ADR-0011 §6), a sibling of Balance/UnitBalance/
; CombatBalance/StructureBalance. Loads the AIConfig tuning resource once at
; boot; AI Opponent code reads AIBalance.ai.* internally. Registered last so
; Balance and StructureTypes (both read by its TR-ai-008 load-time invariant
; check) are already-constructed Autoloads by the time AIBalance._ready() runs.
AIBalance="*res://src/gameplay/ai/ai_balance.gd"

; Thin config Autoload (ADR-0016 §4), a sibling of Balance/UnitBalance/
; CombatBalance/StructureBalance/AIBalance. Loads the HUDConfig tuning resource
; once at boot; Game HUD widgets read HudBalance.hud.* internally. Also runs a
; load-time cross-config guard (TR-hud-008): unlike most siblings it clamps
; ap_tick_duration_ms down to InputConfig.input_lock_ms (push_error + clamp,
; never a crash — see hud_balance.gd for why this differs from AIBalance's
; push_error+OS.crash pattern).
HudBalance="*res://src/ui/game_hud/hud_balance.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input]

; ADR-0014 pre-Accepted spike: board_cursor_cycle is a DEDICATED action,
; distinct from ui_focus_next (Tab), so a future menu re-authoring wiring Tab
; for Control traversal can never accidentally shadow cycle-jump (ADR-0014 §2).
; ★ 2026-08-24: pad binding assigned at last — LEFT STICK CLICK (L3, button 7).
; ADR-0014's Risks section left this open and suggested a shoulder, but both
; shoulders went to the build/produce type cycles (S6-17) before this action was
; ever wired. L3 is the better of what remained and arguably better than a
; shoulder: the left stick and D-pad are what MOVE the cursor, so clicking that
; same stick to snap it to the next highlighted tile is a mnemonic rather than an
; arbitrary assignment. ⚠ Least-discoverable button on a pad — acceptable now only
; because the settings screen (S6-24) lets a player rebind it.
; ui_up/ui_down/ui_left/ui_right are NOT redefined here — they use Godot's
; built-in engine defaults (arrow keys + D-pad), unmodified.
; ⛔⛔ 2026-08-25 (S8-06) — ui_accept / ui_cancel are DECLARED HERE BECAUSE REDOT 26.2 SHIPS THEM
; WITH NO GAMEPAD EVENTS AT ALL. Verified by dumping InputMap.action_get_events() on a clean
; project: ui_accept had Enter / Kp Enter / Space, ui_cancel had Escape, and neither had a single
; joypad button. (ui_up and the other directions DO carry D-pad + stick, so this is specific to
; these two.)
;
; That made CONFIRM and BACK OUT — the two most fundamental controls in the game — unreachable on
; a controller, on a project whose hardware floor is the Steam Deck (S7-08). It also silently
; falsified two Approved specs: action-menu.md's Interaction Map promises A=confirm and B=back,
; and pause.md records "B works with no project binding" because ui_cancel is engine-default.
; ⚠ It was engine-default. The default just does not include a pad.
;
; ⚠ Declaring a built-in action here REPLACES its defaults wholesale, so the original keyboard
; events are restored explicitly below — dropping them would trade a gamepad bug for a keyboard one.
; Found by S8-06's glyph work: asking "what is this action called on a pad?" is what exposed that
; the answer was "nothing".
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194310,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}
board_cursor_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":91,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":93,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)

, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":7,"pressure":0.0,"pressed":false,"script":null)]
}

; ★ 2026-08-24 — gamepad reachability. These six verbs were raw KEY_*
; matches in VerticalSliceRoot._unhandled_input, so they existed only on a
; keyboard: a controller could move the cursor and select (ui_* carry Godot's
; built-in D-pad/A bindings) and then do NOTHING ELSE. Each is now a named
; action carrying its keyboard key AND a pad button, so the two input methods
; stay in lockstep by construction rather than by remembering to update both.
; Face-button layout follows the platform convention the player already has:
; A confirms (ui_accept), B is the other common verb, X/Y are the situational
; ones, shoulders cycle, Start ends the turn.

; ★ 2026-08-24 (action menu) — M / X(Square) is now MOVE ONLY.
; It used to mean "move or attack, whichever the cursor tile supports" — a guess
; the interface made on the player's behalf and could not explain. The contextual
; action menu lists Move and Attack as two separate verbs, so the accelerators
; split to match: this action keeps its NAME (a rename would silently discard
; every player's saved override for it) and gains board_attack as its sibling.
board_act={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":77,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}

; B / LB — place the selected structure (player-level, CR-5)
; ★ 2026-08-24: pad binding moved Y(3) -> LB(9). Y went to board_attack, because
; the two verbs a player uses every single turn belong on face buttons and Build
; is a once-in-a-while command. LB was freed by retiring board_build_cycle.
board_build={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":66,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":9,"pressure":0.0,"pressed":false,"script":null)
]
}

; ★ 2026-08-24 — A / Y(Triangle). NEW, the other half of board_act's split.
; Attack is one of the two verbs a unit uses every turn, so it earns a face
; button; Y was freed by moving Build to a shoulder.
board_attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":3,"pressure":0.0,"pressed":false,"script":null)
]
}

; ★ 2026-08-24 — board_build_cycle ([C]/LB) and board_produce_cycle ([V]/RB) were
; REMOVED here, not rebound. They existed only because there was no way to SHOW a
; list of types, so the player cycled a hidden selection blind. The action menu's
; Produce submenu shows every type with its live cost, and the Build flow does the
; same — keeping the cycles would leave two bindings mutating a choice the menu now
; displays, i.e. two sources of truth for one decision.
; Their pad buttons went to board_build (LB) and board_produce (RB).

; P / RB — open the Produce submenu
; ★ 2026-08-24: pad binding moved B(1) -> RB(10). Godot's built-in ui_cancel
; already carries pad B, so Produce was sharing a button with Cancel — harmless
; while nothing backed out, and a real conflict now that B backs out of the menu.
board_produce={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":10,"pressure":0.0,"pressed":false,"script":null)
]
}

; Tab / Start — end the turn
board_end_turn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":4,"pressure":0.0,"pressed":false,"script":null)
]
}

; ★ 2026-08-24 — the menu focus toggle. ADR-0014 §2 makes arbitration structural:
; a focused Control consumes direction presses before _unhandled_input ever sees
; them, so the board cursor and menu traversal cannot collide. The consequence is
; that SOMETHING has to hand focus over deliberately, since with nothing focused
; every direction goes to the board. Back/Select does that, and doubles as the way
; out — a controller player must never be able to get stuck in the menu.
board_menu_focus={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":8,"pressure":0.0,"pressed":false,"script":null)
]
}

; ★ 2026-08-24 — PAUSE. design/ux/pause.md's Interaction Map names Esc and
; gamepad Start as the open trigger, and Start is the near-universal convention
; for it. Start previously held END TURN (S6-17); that moved to Back/Select and
; the HUD action-panel focus moved to the right-stick click, because a pause
; button that is not Start is a pause button players do not find. ⚠ This is a
; binding judgement, not a rule — it is exactly what the deferred rebinding UI
; (post-gate-backlog item 6) exists to let the player overrule.
; Esc is bound through ui_cancel, which the engine already provides.
board_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

; The art bible's void anchor (#0A0E17). Impassable tiles are deliberately left
; unpainted by BoardRenderer.paint_terrain, so the clear colour IS the void art —
; without this the gaps show Godot's default grey and read as a rendering fault
; rather than as a hole in the floor (assets/art/README.md, art-bible §6.4).
environment/defaults/default_clear_color=Color(0.039215688, 0.05490196, 0.09019608, 1)
