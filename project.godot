; Engine configuration file — OVERCLOCK
; Minimal bootstrap project that initializes the Redot/Godot 4.6 project so the
; GdUnit4 test harness can run headlessly (local + CI). Rendering/input/autoload
; settings are added during Pre-Production as the vertical slice is built.
;
; Engine: Redot 26.2 (Godot 4.6-compatible). See docs/engine-reference/godot/VERSION.md.

config_version=5

[application]

config/name="OVERCLOCK"
run/main_scene="res://scenes/vertical_slice.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; Vertical-slice window. The board (~1408x704 world px) is framed to fit via
; VerticalSliceRoot's fit-to-view camera; resizing refits. Resizable (default).
window/size/viewport_width=1600
window/size/viewport_height=900

[autoload]

; Thin, logic-free lookup Autoload (ADR-0006), mirroring MatchService's
; read-only lookup idiom (ADR-0001). Loads EconomyConfig once at boot;
; AP's static functions read Balance.economy internally.
Balance="*res://src/core/economy/balance.gd"

; Thin, logic-free registry Autoload (ADR-0007), mirroring Balance's idiom.
; Preloads the 4 VS UnitTypeDef presets once at boot; any system reads
; UnitTypes.SCOUT/TROOPER/HEAVY/SNIPER as a bare global reference.
UnitTypes="*res://src/core/unit/unit_types.gd"

; Thin, logic-free config Autoload (ADR-0009), a sibling of Balance. Loads the
; UnitConfig movement-tuning resource once at boot; UnitConfig.surcharge_for()
; reads UnitBalance.units.soft_move_penalty_x10 internally.
UnitBalance="*res://src/core/unit/unit_balance.gd"

; Thin, logic-free config Autoload (ADR-0010), a sibling of Balance/UnitBalance.
; Loads the CombatConfig damage-formula tuning resource once at boot; Combat's
; damage()/preview_damage() read CombatBalance.combat.* internally.
CombatBalance="*res://src/core/combat/combat_balance.gd"

; Thin, logic-free registry Autoload (ADR-0007), mirroring UnitTypes' idiom.
; Preloads the 5 VS StructureTypeDef presets (HQ, Economy/Production Outpost,
; Defensive Structure, Research Lab) once at boot; any system reads
; StructureTypes.HQ/ECONOMY_OUTPOST/... as a bare global reference.
StructureTypes="*res://src/core/structure/structure_types.gd"

; Thin, logic-free config Autoload (ADR-0017 D6), a sibling of Balance/
; UnitBalance/CombatBalance. Loads the BaseProductionConfig tuning resource
; once at boot; Base & Production (and cross-system readers like Combat's
; defensive_attack_cost) read StructureBalance.base_production.* internally.
StructureBalance="*res://src/core/base_production/structure_balance.gd"

; Thin config Autoload (ADR-0011 §6), a sibling of Balance/UnitBalance/
; CombatBalance/StructureBalance. Loads the AIConfig tuning resource once at
; boot; AI Opponent code reads AIBalance.ai.* internally. Registered last so
; Balance and StructureTypes (both read by its TR-ai-008 load-time invariant
; check) are already-constructed Autoloads by the time AIBalance._ready() runs.
AIBalance="*res://src/gameplay/ai/ai_balance.gd"

; Thin config Autoload (ADR-0016 §4), a sibling of Balance/UnitBalance/
; CombatBalance/StructureBalance/AIBalance. Loads the HUDConfig tuning resource
; once at boot; Game HUD widgets read HudBalance.hud.* internally. Also runs a
; load-time cross-config guard (TR-hud-008): unlike most siblings it clamps
; ap_tick_duration_ms down to InputConfig.input_lock_ms (push_error + clamp,
; never a crash — see hud_balance.gd for why this differs from AIBalance's
; push_error+OS.crash pattern).
HudBalance="*res://src/ui/game_hud/hud_balance.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input]

; ADR-0014 pre-Accepted spike: board_cursor_cycle is a DEDICATED action,
; distinct from ui_focus_next (Tab), so a future menu re-authoring wiring Tab
; for Control traversal can never accidentally shadow cycle-jump (ADR-0014 §2).
; Keyboard fallback bound here ([ and ]); shoulder-button primary binding is
; still open per the ADR's own Risks section — not assigned by this spike.
; ui_up/ui_down/ui_left/ui_right are NOT redefined here — they use Godot's
; built-in engine defaults (arrow keys + D-pad), unmodified.
board_cursor_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":91,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":93,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

; ★ 2026-08-24 — gamepad reachability. These six verbs were raw KEY_*
; matches in VerticalSliceRoot._unhandled_input, so they existed only on a
; keyboard: a controller could move the cursor and select (ui_* carry Godot's
; built-in D-pad/A bindings) and then do NOTHING ELSE. Each is now a named
; action carrying its keyboard key AND a pad button, so the two input methods
; stay in lockstep by construction rather than by remembering to update both.
; Face-button layout follows the platform convention the player already has:
; A confirms (ui_accept), B is the other common verb, X/Y are the situational
; ones, shoulders cycle, Start ends the turn.

; M / X(Square) — move-or-attack at the cursor
board_act={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":77,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
]
}

; B / Y(Triangle) — place the selected structure
board_build={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":66,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":3,"pressure":0.0,"pressed":false,"script":null)
]
}

; C / LB — cycle which structure Build places
board_build_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":67,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":9,"pressure":0.0,"pressed":false,"script":null)
]
}

; P / B(Circle) — produce the selected unit type
board_produce={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}

; V / RB — cycle which unit Produce deploys
board_produce_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":86,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":10,"pressure":0.0,"pressed":false,"script":null)
]
}

; Tab / Start — end the turn
board_end_turn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":16777218,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

; ★ 2026-08-24 — the menu focus toggle. ADR-0014 §2 makes arbitration structural:
; a focused Control consumes direction presses before _unhandled_input ever sees
; them, so the board cursor and menu traversal cannot collide. The consequence is
; that SOMETHING has to hand focus over deliberately, since with nothing focused
; every direction goes to the board. Back/Select does that, and doubles as the way
; out — a controller player must never be able to get stuck in the menu.
board_menu_focus={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":4,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

; The art bible's void anchor (#0A0E17). Impassable tiles are deliberately left
; unpainted by BoardRenderer.paint_terrain, so the clear colour IS the void art —
; without this the gaps show Godot's default grey and read as a rendering fault
; rather than as a hole in the floor (assets/art/README.md, art-bible §6.4).
environment/defaults/default_clear_color=Color(0.039215688, 0.05490196, 0.09019608, 1)
